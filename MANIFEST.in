include README.md
include LICENSE
include NOTICE
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SUPPORT.md
include CITATION.cff
include THIRD_PARTY_NOTICES.md
include AGENTS.md
include .legends-module
include .legends-router-pin
include .env.example
include pyproject.toml

recursive-include docs *.md
recursive-include examples *.md *.txt *.jsonl *.json
recursive-include skills *.md
recursive-include assets *.png *.webp *.json
recursive-include scripts *.py
recursive-include tests *.py

prune .git
prune .local
prune batches
prune reports
prune downloads
prune cache
prune secrets
prune cookies
global-exclude .env .env.* *.pyc __pycache__
